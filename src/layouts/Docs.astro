---
import Base from './Base.astro';
import { docsFlat, docsNav } from '../content/docs-nav';
import { SOURCE_TAG, href, source } from '../lib/site';

interface Props {
  frontmatter: { title: string; description?: string; lede?: string; source?: string; sourceAnchor?: string };
}
const { frontmatter: fm } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = Astro.url.pathname.slice(base.length).replace(/^\/docs\/?/, '').replace(/\/$/, '');
const index = docsFlat.findIndex((i) => i.slug === rel);
const prev = index > 0 ? docsFlat[index - 1] : undefined;
const next = index >= 0 && index < docsFlat.length - 1 ? docsFlat[index + 1] : undefined;
const link = (slug: string) => href(slug ? `/docs/${slug}` : '/docs');
const src = fm.source ?? 'docs/reference.md';
---

<Base title={`${fm.title} · Docs`} description={fm.description}>
  <div class="wrap docs">
    <aside class="docs__side">
      <details class="docs__menu" open>
        <summary>Documentation</summary>
        <nav aria-label="Documentation">
          {
            docsNav.map((group) => (
              <div class="docs__group">
                <p class="eyebrow">{group.title}</p>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a href={link(item.slug)} aria-current={item.slug === rel ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="docs__article">
      <header class="docs__head">
        <p class="eyebrow">Docs, Nova {SOURCE_TAG}</p>
        <h1 class="display-1">{fm.title}</h1>
        {fm.lede && <p class="lede">{fm.lede}</p>}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="docs__foot">
        <p class="caption">
          Written from
          <a class="link" href={source(src, fm.sourceAnchor)} rel="noopener">{src}</a>
          at {SOURCE_TAG}. The repository is the reference.
        </p>
        <nav class="docs__pager" aria-label="Pages">
          {prev ? (<a href={link(prev.slug)} class="docs__prev"><span class="caption">Previous</span>{prev.label}</a>) : <span />}
          {next && (<a href={link(next.slug)} class="docs__next"><span class="caption">Next</span>{next.label}</a>)}
        </nav>
      </footer>
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 208px minmax(0, 1fr);
    gap: 40px var(--gap-xl);
    padding-top: calc(var(--nav-h) + var(--section) / 2);
    padding-bottom: var(--section);
    align-items: start;
  }
  .docs__side {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
  }
  .docs__menu summary {
    display: none;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: var(--r-m);
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text);
  }
  .docs__group + .docs__group {
    margin-top: 24px;
  }
  .docs__group ul {
    display: grid;
    gap: 2px;
    margin-top: 8px;
  }
  .docs__group a {
    display: block;
    margin-left: -12px;
    padding: 8px 12px;
    border-radius: var(--r-s);
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text-2);
    transition:
      color 160ms var(--ease),
      background-color 160ms var(--ease);
  }
  .docs__group a:hover {
    color: var(--text);
  }
  .docs__group a[aria-current='page'] {
    color: var(--text);
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .docs__article {
    min-width: 0;
  }
  .docs__head {
    display: grid;
    gap: 16px;
    margin-bottom: 40px;
  }
  .docs__foot {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    max-width: 44rem;
  }
  .docs__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 32px;
  }
  .docs__pager a {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    border-radius: var(--r-l);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 500;
    transition: background-color 160ms var(--ease);
  }
  .docs__pager a:hover {
    background: var(--raised);
  }
  .docs__next {
    text-align: right;
  }
  @media (max-width: 860px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs__side {
      position: static;
    }
    .docs__menu summary {
      display: block;
    }
    .docs__menu nav {
      padding-top: 16px;
    }
  }
</style>

<script>
  // On small screens the sidebar starts collapsed.
  const menu = document.querySelector<HTMLDetailsElement>('.docs__menu');
  if (menu && window.matchMedia('(max-width: 860px)').matches) menu.open = false;
</script>
