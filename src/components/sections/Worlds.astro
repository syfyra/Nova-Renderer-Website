---
// Light and matter: five subjects, one row each. A subject with a render
// shows it above its row.
import RenderFrame from '../media/RenderFrame.astro';
import Fn from '../primitives/Fn.astro';
---

<section class="section worlds" id="light" aria-labelledby="worlds-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Light and matter</p>
      <h2 id="worlds-title" class="display-2">Lights, volumes, hair, subsurface scattering and sky</h2>
    </header>

    <ol class="worlds__rows">
      <li class="world">
        <RenderFrame id="world-lights" ratio="21 / 9" class="world__frame" />
        <h3 class="display-3">Many lights</h3>
        <p class="world__text">
          A light tree over every bounded light, with lights at infinity chosen by importance. Every UsdLux light with
          Karma’s conventions, light and shadow linking, portals, and emissive meshes as lights.
        </p>
        <p class="world__fact">
          <span class="fact__value">100<small>×</small></span>
          <span class="fact__label">less variance than selection by power on a street of 2000 lights<Fn id="light-tree" /></span>
        </p>
      </li>
      <li class="world">
        <RenderFrame id="world-volumes" ratio="21 / 9" class="world__frame" />
        <h3 class="display-3">Volumes</h3>
        <p class="world__text">
          VDB and native Houdini volumes through NanoVDB, with the Karma Pyro Material. Unbiased spectral tracking on
          majorants derived from the volume shader. There is no step rate to tune.
        </p>
        <p class="world__fact">
          <span class="fact__value">2.3–4.2<small>×</small></span>
          <span class="fact__label">
            faster than Karma CPU on one pyro simulation at equal accuracy,<Fn id="pyro" /> and within 0.1–1.8&nbsp;% of
            its image<Fn id="volumes-match" />
          </span>
        </p>
      </li>
      <li class="world">
        <RenderFrame id="world-hair" ratio="21 / 9" class="world__frame" />
        <h3 class="display-3">Hair</h3>
        <p class="world__text">
          Karma Hair, Karma Fur and MaterialX <span class="mono">chiang_hair_bsdf</span> on the Chiang fibre model,
          with Karma’s conventions for melanin, absorption, tilt and roughness
        </p>
        <p class="world__fact">
          <span class="fact__value">4</span>
          <span class="fact__label">curve bases, linear to Catmull-Rom, as ribbons or round tubes, with motion blur and instancing</span>
        </p>
      </li>
      <li class="world">
        <RenderFrame id="world-sss" ratio="21 / 9" class="world__frame" />
        <h3 class="display-3">Subsurface</h3>
        <p class="world__text">
          Random-walk subsurface scattering for Standard Surface, OpenPBR and the Principled Shader, with Karma’s
          parameterization
        </p>
        <p class="world__fact">
          <span class="fact__value">0.7<small>%</small></span>
          <span class="fact__label">the most it differs from Karma across Karma’s 47 calibration scenes<Fn id="sss" /></span>
        </p>
      </li>
      <li class="world">
        <RenderFrame id="world-sky" ratio="21 / 9" class="world__frame" />
        <h3 class="display-3">Sky</h3>
        <p class="world__text">
          Karma’s sky model as a textured dome, the sun, and a planetary atmosphere with Rayleigh, Mie and ozone
          scattering as a medium in the path tracer
        </p>
        <p class="world__fact">
          <span class="fact__value">3</span>
          <span class="fact__label">Karma nodes behind it: Sky Dome Light, Physical Sky and Sky Atmosphere</span>
        </p>
      </li>
    </ol>
  </div>
</section>

<style>
  .world {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: 16px var(--gap-m);
    align-items: start;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .world:last-child {
    border-bottom: 1px solid var(--line);
  }
  .world :global(.world__frame) {
    grid-column: 1 / -1;
    margin-bottom: 16px;
  }
  .world__text {
    color: var(--text-2);
    max-width: var(--measure);
  }
  .world__text .mono {
    color: var(--text);
  }
  .world__fact {
    display: grid;
    gap: 8px;
  }
  @media (max-width: 900px) {
    .world {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
