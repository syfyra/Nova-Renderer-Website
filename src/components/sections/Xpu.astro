---
// Chapter three: speed on the GPU. The figure counts up and the bars grow
// when the chart comes into view (motion/core.ts).
import BenchBars from '../data/BenchBars.astro';
import Fn from '../primitives/Fn.astro';
import Icon from '../primitives/Icon.astro';
import { xpu, xpuHome } from '../../content/benchmarks';
import { href } from '../../lib/site';

const rows = xpuHome
  .map((name) => xpu.find((r) => r.scene === name)!)
  .map((r) => ({ label: r.scene, sub: r.what, a: r.cpuMs, b: r.xpuMs, ratio: `${r.perSample.toFixed(1)}×` }));
---

<section class="section xpu" id="xpu" aria-labelledby="xpu-title">
  <div class="wrap">
    <div class="xpu__grid">
      <div class="xpu__lead">
        <p class="eyebrow" data-reveal>On the GPU</p>
        <h2 id="xpu-title" class="figure" data-drift="20">
          <span class="sr-only">Nova XPU renders 9 to 16 times faster per sample than the 16-thread CPU</span>
          <span aria-hidden="true"><span data-count>9–16</span>×</span>
        </h2>
        <p class="figure-claim" data-reveal>the speed of a 16-thread CPU, per sample, on surfaces<Fn id="xpu-per-sample" /></p>
        <p class="body" data-reveal>Volumes and heavy layered materials gain about 4×</p>
        <a class="arrow" href={href('/benchmarks')} data-reveal>All eleven scenes <Icon name="arrow-right" /></a>
      </div>

      <BenchBars
        rows={rows}
        nameA="CPU"
        nameB="XPU"
        unit="ms"
        caption="Time per sample at 960×540, without setup. Lower is better. GeForce RTX 5080 against a Ryzen 7 9800X3D with 16 threads."
      />
    </div>

    <div class="facts xpu__facts" data-stagger>
      <div class="fact">
        <p class="fact__value"><span data-count>4.3–7.7</span><small>×</small></p>
        <p class="fact__label">end to end at 64 samples, setup included<Fn id="xpu-end-to-end" /></p>
      </div>
      <div class="fact">
        <p class="fact__value">≈ <span data-count>0.3</span><small>s</small></p>
        <p class="fact__label">of setup per render</p>
      </div>
      <div class="fact">
        <p class="fact__value"><span data-count>7</span><small>ms</small></p>
        <p class="fact__label">per pass after an edit, in a scene of 4.2 million triangles<Fn id="xpu-ipr" /></p>
      </div>
    </div>
  </div>
</section>

<style>
  .xpu__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px var(--gap-xl);
    align-items: start;
  }
  .xpu__lead {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .xpu__facts {
    margin-top: var(--gap-l);
  }
  @media (max-width: 900px) {
    .xpu__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
