---
// Chapter five: materials. Five cards, one line each.
import RenderFrame from '../media/RenderFrame.astro';
import Fn from '../primitives/Fn.astro';
---

<section class="section materials" id="materials" aria-labelledby="materials-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>Materials</p>
      <h2 id="materials-title" class="display-2" data-words>Your materials render as authored</h2>
    </header>

    <ul class="materials__grid" data-stagger>
      <li class="mat mat--wide card">
        <RenderFrame id="mat-materialx" ratio="16 / 9" sizes="(min-width: 900px) 46vw, 92vw" />
        <div class="mat__body">
          <p class="eyebrow">MaterialX 1.39</p>
          <h3 class="mat__title">Standard Surface, OpenPBR, any pbrlib graph</h3>
          <p class="mat__text">740 of 746 node definitions, with Karma’s semantics<Fn id="materialx" /></p>
        </div>
      </li>
      <li class="mat mat--wide card">
        <RenderFrame id="mat-kma" ratio="16 / 9" sizes="(min-width: 900px) 46vw, 92vw" />
        <div class="mat__body">
          <p class="eyebrow">Karma Material Builder</p>
          <h3 class="mat__title">Karma’s own shading nodes</h3>
          <p class="mat__text">35 of Karma’s 55 <span class="mono">kma_*</span> nodes<Fn id="kma" /></p>
        </div>
      </li>
      <li class="mat card">
        <RenderFrame id="mat-principled" ratio="4 / 3" sizes="(min-width: 900px) 30vw, 92vw" />
        <div class="mat__body">
          <p class="eyebrow">Principled Shader</p>
          <h3 class="mat__title">Houdini’s Principled Shader, natively</h3>
          <p class="mat__text">Sheen, clearcoat, metal and reflectivity by its own rules</p>
        </div>
      </li>
      <li class="mat card">
        <RenderFrame id="mat-vex" ratio="4 / 3" sizes="(min-width: 900px) 30vw, 92vw" />
        <div class="mat__body">
          <p class="eyebrow">VEX</p>
          <h3 class="mat__title">VEX Material Builders through a CVEX bridge</h3>
          <p class="mat__text">On the CPU. On the GPU they render as grey stand-ins.</p>
        </div>
      </li>
      <li class="mat card">
        <RenderFrame id="mat-displacement" ratio="4 / 3" sizes="(min-width: 900px) 30vw, 92vw" />
        <div class="mat__body">
          <p class="eyebrow">Displacement and textures</p>
          <h3 class="mat__title">Diced from the camera, UDIMs through OpenImageIO</h3>
          <p class="mat__text">Float and vector displacement at Karma’s dicing quality</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .materials__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
  }
  .mat {
    grid-column: span 4;
    overflow: hidden;
  }
  .mat--wide {
    grid-column: span 6;
  }
  /* A card rises a little under the pointer. */
  @media (hover: hover) {
    .mat:hover {
      transform: translateY(-4px);
    }
    .mat:hover .mat__title {
      color: var(--text);
    }
  }
  /* A picture sits flush in the card; the card's corners are its corners. */
  .mat :global(.frame) {
    border-radius: 0;
    box-shadow: inset 0 -1px 0 0 var(--line);
  }
  .mat__body {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
  }
  .mat__title {
    font-size: var(--t-24);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .mat__text {
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text-2);
  }
  .mat__text .mono {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .mat,
    .mat--wide {
      grid-column: span 6;
    }
  }
  @media (max-width: 620px) {
    .mat,
    .mat--wide {
      grid-column: 1 / -1;
    }
  }
</style>
