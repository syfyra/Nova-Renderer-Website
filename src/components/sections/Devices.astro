---
import CompareSlider from '../media/CompareSlider.astro';
import Fn from '../primitives/Fn.astro';
import { slotVisible } from '../../content/renders';

const compare = slotVisible('same-cpu', 'same-xpu');
---

<section class="section devices" id="devices" aria-labelledby="devices-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Two renderers</p>
      <h2 id="devices-title" class="display-2">The same image on the CPU and on the GPU</h2>
      <p class="lede">
        Houdini sees Nova as two renderers. Both run the same code with the same random numbers, so a GPU render matches
        the CPU’s image up to floating-point rounding.
      </p>
    </header>

    {compare && <CompareSlider a="same-cpu" b="same-xpu" labelA="Nova, CPU" labelB="Nova XPU, GPU" ratio="2 / 1" name="CPU and GPU comparison" />}
    <p class="devices__note">On the reference scenes, every pixel agrees within 1&nbsp;%<Fn id="same-image" /></p>

    <div class="devices__pair">
      <article class="device">
        <p class="eyebrow">CPU</p>
        <h3 class="display-3">Nova</h3>
        <ul class="device__list">
          <li>Embree 4</li>
          <li>A wavefront path tracer</li>
          <li>A SIMD shading VM</li>
        </ul>
        <p class="device__req">Runs on any x64 CPU with AVX2</p>
      </article>
      <article class="device">
        <p class="eyebrow">NVIDIA GPU</p>
        <h3 class="display-3">Nova XPU</h3>
        <ul class="device__list">
          <li>CUDA wavefront kernels</li>
          <li>OptiX 9 ray tracing</li>
          <li>The same bytecode VM, closures and light tree</li>
        </ul>
        <p class="device__req">Needs an RTX 50 series card. Without a usable GPU it renders on the CPU and says so.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .devices__note {
    margin-top: 16px;
    color: var(--text-2);
    font-size: var(--t-14);
    line-height: 20px;
  }
  .devices__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px var(--gap-m);
    margin-top: var(--gap-l);
  }
  .device {
    border-top: 1px solid var(--line-2);
    padding-top: 24px;
  }
  .device .display-3 {
    margin-top: 4px;
  }
  .device__list {
    margin-top: 24px;
  }
  .device__list li {
    padding-block: 12px;
    border-top: 1px solid var(--line);
    line-height: 24px;
    color: var(--text);
  }
  .device__list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .device__req {
    padding-top: 12px;
    color: var(--text-2);
    font-size: var(--t-14);
    line-height: 20px;
    max-width: 30em;
  }
  @media (max-width: 760px) {
    .devices__pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
