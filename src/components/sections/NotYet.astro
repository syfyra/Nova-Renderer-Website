---
import Icon from '../primitives/Icon.astro';
import { limitations } from '../../content/limitations';
import { VERSION, href } from '../../lib/site';
---

<section class="section notyet" id="not-yet" aria-labelledby="notyet-title">
  <div class="wrap notyet__grid">
    <header class="notyet__lead">
      <p class="eyebrow">Limitations</p>
      <h2 id="notyet-title" class="display-2">What Nova {VERSION} does not do yet</h2>
      <p class="body">Differences from Karma are documented with the feature they belong to</p>
      <a class="arrow" href={href('/docs/limitations')}>The full list <Icon name="arrow-right" /></a>
    </header>
    <div class="notyet__cols">
      {
        limitations.map((group) => (
          <section>
            <h3 class="eyebrow">{group.title}</h3>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .notyet__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 40px var(--gap-xl);
    align-items: start;
  }
  .notyet__lead {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .notyet__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px var(--gap-m);
  }
  .notyet__cols ul {
    margin-top: 8px;
  }
  .notyet__cols li {
    padding-block: 12px;
    border-top: 1px solid var(--line);
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text);
  }
  @media (max-width: 900px) {
    .notyet__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .notyet__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
