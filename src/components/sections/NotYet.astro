---
// Chapter ten: what is missing. One group is open at a time; the rest are a
// title and a count until they are asked for.
import Icon from '../primitives/Icon.astro';
import { limitations } from '../../content/limitations';
import { VERSION, href } from '../../lib/site';
---

<section class="section notyet" id="not-yet" aria-labelledby="notyet-title">
  <div class="wrap notyet__grid">
    <header class="notyet__lead">
      <p class="eyebrow" data-reveal>Limitations</p>
      <h2 id="notyet-title" class="display-2" data-words>What Nova {VERSION} does not do yet</h2>
      <a class="arrow" href={href('/docs/limitations')} data-reveal>The full list <Icon name="arrow-right" /></a>
    </header>
    <div class="notyet__groups" data-stagger>
      {
        limitations.map((group, i) => (
          <details class="limit" name="limits" open={i === 0}>
            <summary>
              <span class="limit__title">{group.title}</span>
              <span class="caption num">{group.items.length}</span>
              <Icon name="chevron-down" />
            </summary>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .notyet__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px var(--gap-xl);
    align-items: start;
  }
  .notyet__lead {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .notyet__groups {
    border-bottom: 1px solid var(--line);
  }
  .limit {
    border-top: 1px solid var(--line);
  }
  .limit summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
    cursor: pointer;
    list-style: none;
    color: var(--text-2);
    transition: color 160ms var(--ease);
  }
  .limit summary::-webkit-details-marker {
    display: none;
  }
  .limit summary:hover,
  .limit[open] summary {
    color: var(--text);
  }
  .limit__title {
    font-size: var(--t-18);
    line-height: 24px;
    font-weight: 500;
    transition: transform 300ms var(--ease);
  }
  .limit summary:hover .limit__title {
    transform: translateX(4px);
  }
  .limit summary :global(.icon) {
    color: var(--text-3);
  }
  .limit[open] summary :global(.icon) {
    transform: rotate(180deg);
  }
  .limit ul {
    padding-bottom: 20px;
  }
  .limit li {
    padding-block: 8px;
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text-2);
    max-width: 44em;
  }
  @media (max-width: 900px) {
    .notyet__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
