---
import CodeBlock from '../primitives/CodeBlock.astro';
import Requirements from '../data/Requirements.astro';
import { getGitHub } from '../../lib/github';
import { href } from '../../lib/site';

const gh = await getGitHub();
---

<section class="section start" id="get-started" aria-labelledby="start-title">
  <div class="wrap">
    <div class="start__panel card">
      <div class="start__lead">
        <p class="eyebrow">Get started</p>
        <h2 id="start-title" class="display-2">Install Nova for Houdini 22.0</h2>
        <p class="lede">Free and open source. One installer, per user, without administrator rights.</p>
        <div class="start__cta">
          <a class="btn btn--primary" href={gh.installerUrl ?? gh.releaseUrl} rel="noopener">
            <span class="btn__dot" aria-hidden="true"></span>
            Download {gh.installerName}
          </a>
          <a class="btn" href={href('/docs/build')}>Build from source</a>
        </div>
        <p class="caption">
          Version {gh.version}{gh.installerSize && ` · ${gh.installerSize}`} · MIT License ·{' '}
          <a class="link" href={href('/download')}>All download options</a>
        </p>
        <Requirements />
      </div>

      <ol class="start__steps">
        <li>
          <span class="caption num">1</span>
          <div>
            <h3>Install</h3>
            <p>Close Houdini and run the installer. It registers Nova with Houdini 22.0 and adds an uninstaller to Apps &amp; features.</p>
          </div>
        </li>
        <li>
          <span class="caption num">2</span>
          <div>
            <h3>Choose the renderer</h3>
            <p>In Solaris, pick <strong>Nova CPU</strong> or <strong>Nova XPU</strong> in the viewport’s renderer menu</p>
          </div>
        </li>
        <li>
          <span class="caption num">3</span>
          <div>
            <h3>Set up a render</h3>
            <p>
              Press <kbd>Tab</kbd> and choose Rendering, then <strong>Nova (Setup)</strong>. It builds render settings, a
              render pass and a USD Render ROP, as Karma (Setup) does. Existing Karma setups render as they are.
            </p>
          </div>
        </li>
        <li>
          <span class="caption num">4</span>
          <div>
            <h3>Or render with husk</h3>
            <CodeBlock
              label="husk"
              lines={['husk --renderer Nova scene.usda -o out.exr', 'husk --renderer "Nova XPU" scene.usda -o out.exr']}
            />
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .start__panel {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 40px var(--gap-xl);
    padding: var(--gap-l);
    border-radius: var(--r-xl);
  }
  .start__lead {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .start__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .start__lead :global(.req) {
    margin-top: 8px;
  }
  .start__steps li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .start__steps li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .start__steps .caption {
    line-height: 24px;
  }
  .start__steps h3 {
    font-size: var(--t-16);
    line-height: 24px;
  }
  .start__steps p {
    margin-top: 4px;
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text-2);
  }
  .start__steps strong {
    color: var(--text);
    font-weight: 500;
  }
  .start__steps :global(.code) {
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .start__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
