---
import Fn from '../primitives/Fn.astro';

// Karma's render var names (tests/husk/check_aovs.py); expressions only where
// the repository states them. `pass` names the live pass drawn on the layer
// (src/motion/aov.ts).
const layers = [
  { name: 'C', lpe: 'beauty', pass: 'beauty' },
  { name: 'directdiffuse', lpe: 'C<RD>L', pass: 'directdiffuse' },
  { name: 'indirectdiffuse', lpe: '', pass: 'indirectdiffuse' },
  { name: 'directglossyreflection', lpe: 'C<RG>L', pass: 'directglossy' },
  { name: 'indirectglossyreflection', lpe: '', pass: 'indirectglossy' },
  { name: 'visiblelights', lpe: '', pass: 'visiblelights' },
  { name: 'N', lpe: 'normals', pass: 'normals' },
  { name: 'Cryptomatte', lpe: 'objects', pass: 'ids' },
];
---

<section class="section output" id="output" aria-labelledby="output-title">
  <div class="wrap">
    <div class="output__grid">
      <div class="output__lead">
        <p class="eyebrow">Output</p>
        <h2 id="output-title" class="display-2">Every pass Karma writes, under the same names</h2>
        <p class="lede">
          One Solaris setup renders in both renderers. The components sum to the beauty per sample, and every component
          is unbiased.
        </p>
        <dl class="output__list">
          <div>
            <dt>Light path expressions</dt>
            <dd>Karma’s dialect, with tags on lights, objects and materials, and the <span class="mono">unoccluded;</span> and <span class="mono">shadow;</span> prefixes</dd>
          </div>
          <div>
            <dt>Utility AOVs</dt>
            <dd>Position, normals, depth, motion vectors, ids, any primvar, material AOVs and ambient occlusion</dd>
          </div>
          <div>
            <dt>Cryptomatte</dt>
            <dd>For objects, materials and any string or int primvar. The manifests match Karma’s entry for entry.</dd>
          </div>
          <div>
            <dt>EXR</dt>
            <dd>Multi-part and deep EXR, per-var sample filters, checkpoints with resume</dd>
          </div>
        </dl>
        <p class="caption output__cost">
          No cost with the beauty only. Karma’s standard set of light path expressions costs 6–13&nbsp;% of the render
          time.<Fn id="lpe-cost" />
        </p>
      </div>

      <div class="output__stage">
        <div class="stack" data-stack aria-hidden="true">
          <div class="stack__scene" data-stack-scene>
            {
              layers.map((l, i) => (
                <div class="stack__layer" style={`--i:${i}`} data-stack-layer>
                  <canvas data-aov={l.pass} width="448" height="252" />
                  <p class="stack__label caption">
                    <span>{l.name}</span>
                    {l.lpe && <span class="stack__lpe">{l.lpe}</span>}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
        <p class="caption output__live">
          Passes of the hero’s scene, path traced in your browser. The five light components sum to the beauty. Not Nova.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .output__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px var(--gap-xl);
    align-items: center;
  }
  .output__lead {
    display: grid;
    gap: 16px;
  }
  .output__list {
    margin: 16px 0 0;
  }
  .output__list > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 4px 16px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }
  .output__list dt {
    font-weight: 500;
    line-height: 24px;
  }
  .output__list dd {
    margin: 0;
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text-2);
  }
  .output__list .mono {
    color: var(--text);
  }
  .output__cost {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    max-width: 40em;
  }

  /* The layer stack: flat at first, pulled apart along z by --k (0..1). */
  .output__stage {
    position: relative;
  }
  .stack {
    --k: 1;
    position: relative;
    aspect-ratio: 1 / 1.08;
    perspective: 2600px;
    perspective-origin: 50% 40%;
  }
  .stack__scene {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 50%;
    aspect-ratio: 16 / 9;
    transform-style: preserve-3d;
    transform: translateY(calc(-50% + var(--k) * 22%)) rotateX(calc(var(--k) * 60deg)) rotateZ(calc(var(--k) * -40deg))
      scale(calc(1 - var(--k) * 0.22));
  }
  .stack__layer {
    position: absolute;
    inset: 0;
    border-radius: var(--r-m);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transform: translateZ(calc(var(--i) * var(--k) * 56px));
    opacity: calc(min(1, var(--k) * 4 + (1 - min(1, var(--i)))));
    overflow: hidden;
  }
  .stack canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }
  .stack canvas[data-ready] {
    opacity: 1;
  }
  .stack__label {
    position: absolute;
    left: 8px;
    bottom: 8px;
    display: flex;
    gap: 8px;
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    opacity: calc(var(--k) * 1.5 - 0.3);
  }
  .stack__layer:first-child .stack__label {
    opacity: 1;
  }
  .stack__lpe {
    color: var(--text-3);
  }
  .output__live {
    display: none;
    margin-top: 16px;
    text-align: center;
  }
  .output__stage:has(.stack[data-live]) .output__live {
    display: block;
  }
  @media (max-width: 900px) {
    .output__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .output__list > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
