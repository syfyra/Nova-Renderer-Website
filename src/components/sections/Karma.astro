---
// Chapter one: the scene. The twelve Karma LOPs light up one after another
// as the list scrolls through the view (motion/home.ts).
import CompareSlider from '../media/CompareSlider.astro';
import Icon from '../primitives/Icon.astro';
import { href } from '../../lib/site';
import { slotVisible } from '../../content/renders';

const compare = slotVisible('karma-karma', 'karma-nova');

// The twelve visible Karma LOPs (README, docs/reference.md "Karma's Solaris nodes").
const lops = [
  'Karma Render Settings',
  'Karma Render Products',
  'Karma Standard Render Vars',
  'Karma Cryptomatte',
  'Karma Sky Dome Light',
  'Karma Physical Sky',
  'Karma Sky Atmosphere',
  'Karma Shadow Catcher',
  'Karma Background Plate',
  'Karma Blocker Light Filter',
  'Karma Fog Box',
  'Karma Texture Baker',
];
---

<section class="section karma" id="karma" aria-labelledby="karma-title">
  <div class="wrap">
    <div class="karma__grid">
      <header class="karma__lead">
        <p class="eyebrow" data-reveal>The scene</p>
        <h2 id="karma-title" class="display-2" data-words>Start with the scene you built for Karma</h2>
        <p class="lede" data-reveal>
          Nova reads Karma’s render settings, follows its light conventions and writes its AOV names. A setting it does
          not support warns once per stage.
        </p>
        <a class="arrow" href={href('/docs/karma')} data-reveal>Compatibility in detail <Icon name="arrow-right" /></a>
      </header>

      <div class="karma__list" data-karma>
        <p class="karma__count">
          <span class="karma__n num" data-karma-n>12</span>
          <span class="eyebrow">of 12 visible Karma LOPs render in Nova</span>
        </p>
        <ol data-focus>
          {
            lops.map((name, i) => (
              <li data-karma-item>
                <span class="caption num">{i + 1}</span>
                <span class="karma__name">{name}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    {
      compare && (
        <>
          <div class="karma__compare" data-reveal>
            <CompareSlider a="karma-karma" b="karma-nova" labelA="Karma CPU" labelB="Nova" ratio="2 / 1" name="Karma and Nova comparison" />
          </div>
          <p class="caption karma__caption">One scene, one setup, two renderers</p>
        </>
      )
    }
  </div>
</section>

<style>
  .karma__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px var(--gap-xl);
    align-items: start;
  }
  .karma__lead {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .karma__count {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 16px;
  }
  .karma__n {
    font-size: var(--h2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    min-width: 1.3em;
  }
  .karma__list ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(6, auto);
    grid-auto-flow: column;
    column-gap: var(--gap-m);
  }
  .karma__list li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    column-gap: 12px;
    align-items: baseline;
    padding-block: 12px;
    border-top: 1px solid var(--line);
    color: var(--text);
    transition:
      color 400ms var(--ease),
      opacity 240ms var(--ease);
  }
  .karma__list li .caption {
    text-align: right;
  }
  .karma__name {
    font-weight: 500;
    line-height: 24px;
    transition: transform 300ms var(--ease);
  }
  .karma__list li:hover .karma__name {
    transform: translateX(4px);
  }
  /* Scrolling lights the names one after another. */
  :global(html.motion) .karma__list li:not([data-lit]) {
    color: var(--text-3);
  }
  .karma__compare {
    margin-top: var(--gap-l);
  }
  .karma__caption {
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .karma__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .karma__list ol {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }
</style>
