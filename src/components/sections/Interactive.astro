---
import CompareSlider from '../media/CompareSlider.astro';
import Fn from '../primitives/Fn.astro';
import { ipr, iprHome } from '../../content/benchmarks';
import { slotVisible } from '../../content/renders';

const compare = slotVisible('denoise-noisy', 'denoise-clean');
const rows = iprHome.map((name) => ipr.find((r) => r.edit === name)!);
const max = 100; // the budget for an edit, in milliseconds
---

<section class="section interactive" id="interactive" aria-labelledby="interactive-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Look-dev and IPR</p>
      <h2 id="interactive-title" class="display-2">An edit shows in milliseconds</h2>
      <p class="lede">
        After an edit the viewport renders one pixel per 4×4 block, then per 2×2, then every pixel. Those samples count
        towards the image. Move the light below to see the idea.
      </p>
    </header>

    <div class="interactive__grid">
      <figure class="viewport card" data-proxy>
        <div class="viewport__bar">
          <span class="caption">Viewport, live illustration</span>
          <span class="caption num viewport__stage" data-proxy-stage aria-live="off">256 spp</span>
        </div>
        <div class="viewport__screen">
          <canvas
            class="viewport__live"
            data-proxy-live
            tabindex="0"
            role="img"
            aria-label="The Nova wordmark lit by a movable orange light, path traced live. After each move the picture returns in coarse 4 by 4 blocks, then 2 by 2 blocks, then at full resolution while its noise clears. Arrow keys move the light."
          ></canvas>
          <canvas class="viewport__flat" data-proxy-canvas width="480" height="300" role="img" aria-label="Illustration: a picture refines from coarse 4 by 4 blocks to 2 by 2 blocks to full resolution, then loses its noise as samples accumulate."></canvas>
          <p class="viewport__hint caption" data-proxy-hint aria-hidden="true">Drag the light</p>
        </div>
        <figcaption class="viewport__foot">
          <button type="button" class="btn btn--small" data-proxy-edit>Move the light</button>
          <span class="caption viewport__note viewport__note--live">Path traced in your browser. The proxy passes are held longer so you can see them. Not Nova.</span>
          <span class="caption viewport__note viewport__note--flat">Drawn in your browser and slowed down. Not a Nova render.</span>
        </figcaption>
      </figure>

      <div class="latency">
        <p class="eyebrow">Edit to first image, CPU<Fn id="ipr" /></p>
        <ul>
          {
            rows.map((r) => (
              <li>
                <span class="latency__edit">{r.edit}</span>
                <span class="caption num latency__ms">{r.total}</span>
                <span class="latency__bar"><i style={`--w:${(r.ms / max).toFixed(3)}`} /></span>
              </li>
            ))
          }
        </ul>
        <p class="caption latency__scale"><span>0</span><span>100 ms</span></p>
        <p class="latency__note">
          Measured at 1280×720 on a scene of 980 000 triangles with 20 000 instances. Every measured edit stays below
          100&nbsp;ms.
        </p>
      </div>
    </div>

    <div class:list={['interactive__more', { 'interactive__more--plain': !compare }]}>
      {compare && <CompareSlider a="denoise-noisy" b="denoise-clean" labelA="16 samples" labelB="Denoised" ratio="16 / 10" name="Noisy and denoised comparison" />}
      <dl class="interactive__rows">
        <div>
          <dt>OptiX denoiser</dt>
          <dd>
            For final frames and in the viewport, guided by the first-hit albedo and normal. Alpha stays exact. One
            denoise takes 8&nbsp;ms at 1080p and 31&nbsp;ms at 4K on an RTX 5080.<Fn id="denoise" />
          </dd>
        </div>
        <div>
          <dt>Adaptive sampling</dt>
          <dd>
            Each pixel stops once its noise estimate is low enough, decided at power-of-two checkpoints so renders stay
            deterministic. About 3× faster at equal error on a glass scene, and about even on uniformly noisy
            ones.<Fn id="adaptive" />
          </dd>
        </div>
        <div>
          <dt>Look-dev tools</dt>
          <dd>Contour, depth and crease outlines, headlight and dome overrides, simplified shading, and path guiding on the CPU and on the GPU</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .interactive__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px var(--gap-l);
    align-items: start;
  }

  .viewport {
    overflow: hidden;
  }
  .viewport__bar,
  .viewport__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
  }
  .viewport__bar .viewport__stage {
    color: var(--text);
  }
  .viewport__screen {
    position: relative;
    background: var(--bg);
    border-block: 1px solid var(--line);
  }
  .viewport__screen canvas {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    image-rendering: pixelated;
  }
  /* The live canvas replaces the flat one where WebGL 2 is available. */
  .viewport__screen .viewport__live,
  .viewport__hint,
  .viewport__note--live {
    display: none;
  }
  .viewport[data-live] .viewport__live {
    display: block;
    image-rendering: auto;
    cursor: grab;
    touch-action: pan-y;
  }
  .viewport[data-live] .viewport__live:active {
    cursor: grabbing;
  }
  .viewport[data-live] .viewport__flat,
  .viewport[data-live] .viewport__note--flat {
    display: none;
  }
  .viewport[data-live] .viewport__note--live {
    display: inline;
  }
  .viewport[data-live] .viewport__hint {
    display: block;
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 4px 8px;
    border-radius: var(--r-s);
    background: var(--bg);
    color: var(--text);
    pointer-events: none;
    transition: opacity 300ms var(--ease);
  }
  .viewport__hint[data-used] {
    opacity: 0;
  }
  .viewport__foot {
    flex-wrap: wrap;
  }
  .viewport__note {
    flex: 1 1 256px;
    text-align: right;
  }

  .latency ul {
    margin-top: 12px;
  }
  .latency li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 16px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  .latency__edit {
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text);
  }
  .latency__ms {
    line-height: 20px;
    color: var(--text-2);
  }
  .latency__bar {
    grid-column: 1 / -1;
    position: relative;
    height: 4px;
    background: var(--line);
    border-radius: 2px;
  }
  .latency__bar i {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: var(--text-2);
    transform-origin: 0 50%;
    transform: scaleX(var(--w));
  }
  .latency__scale {
    display: flex;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
  .latency__note {
    margin-top: 16px;
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text-2);
  }

  .interactive__more {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px var(--gap-l);
    align-items: center;
    margin-top: var(--gap-l);
  }
  .interactive__more--plain {
    grid-template-columns: minmax(0, 1fr);
  }
  .interactive__rows {
    margin: 0;
  }
  .interactive__rows > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 4fr);
    gap: 4px 24px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .interactive__rows > div:last-child {
    border-bottom: 1px solid var(--line);
  }
  .interactive__rows dt {
    font-weight: 500;
    line-height: 24px;
  }
  .interactive__rows dd {
    margin: 0;
    color: var(--text-2);
    font-size: var(--t-14);
    line-height: 20px;
    max-width: 44em;
  }
  @media (max-width: 900px) {
    .interactive__grid,
    .interactive__more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .interactive__rows > div {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Stacked under the button, the note reads from the same left edge. */
    .viewport__note {
      text-align: left;
    }
  }
</style>
