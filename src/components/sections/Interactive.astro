---
import CompareSlider from '../media/CompareSlider.astro';
import Fn from '../primitives/Fn.astro';
import { ipr, iprHome } from '../../content/benchmarks';
import { slotVisible } from '../../content/renders';

const compare = slotVisible('denoise-noisy', 'denoise-clean');

const rows = iprHome.map((name) => ipr.find((r) => r.edit === name)!);
const max = 100; // PLAN.md's budget for an edit, in milliseconds
---

<section class="section interactive" id="interactive" aria-labelledby="interactive-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal="fade"><b>08</b> Look-dev and IPR</p>
      <h2 id="interactive-title" class="display-2" data-reveal="lines">Now move the light.</h2>
      <p class="lede" data-reveal="fade">The picture answers in milliseconds: 4×4 blocks, then 2×2, then every pixel.</p>
    </header>

    <div class="interactive__grid">
      <figure class="viewport" data-proxy data-reveal="frame" data-spot>
        <div class="viewport__bar">
          <span class="caption">Viewport · live illustration</span>
          <span class="caption num viewport__stage" data-proxy-stage aria-live="off">0256 spp</span>
        </div>
        <div class="viewport__screen">
          <canvas
            class="viewport__live"
            data-proxy-live
            tabindex="0"
            role="img"
            aria-label="The Nova wordmark lit by a movable orange light, path traced live. After each move the picture returns in coarse 4 by 4 blocks, then 2 by 2 blocks, then at full resolution while its noise clears. Arrow keys move the light."
          ></canvas>
          <canvas class="viewport__flat" data-proxy-canvas width="480" height="300" role="img" aria-label="Illustration: a picture refines from coarse 4 by 4 blocks to 2 by 2 blocks to full resolution, then loses its noise as samples accumulate."></canvas>
          <p class="viewport__hint glass caption" data-proxy-hint aria-hidden="true">Drag the light</p>
        </div>
        <figcaption class="viewport__foot">
          <button type="button" class="btn btn--small" data-proxy-edit>
            <span class="viewport__dot" aria-hidden="true"></span>
            Move the light
          </button>
          <span class="caption viewport__note viewport__note--live">Path traced in your browser. The proxy passes are held longer so you can see them. Not Nova.</span>
          <span class="caption viewport__note viewport__note--flat">Drawn in your browser and slowed down. Not a Nova render.</span>
        </figcaption>
      </figure>

      <div class="latency" data-reveal="fade">
        <p class="caption latency__title">Edit to first image, CPU<Fn id="ipr" /></p>
        <ul data-bars data-focus>
          {
            rows.map((r) => (
              <li>
                <span class="latency__edit">{r.edit}</span>
                <span class="latency__ms num">{r.total}</span>
                <span class="latency__bar"><i data-bar style={`--w:${(r.ms / max).toFixed(3)}`} /></span>
              </li>
            ))
          }
        </ul>
        <p class="caption latency__scale"><span>0</span><span>100 ms</span></p>
        <p class="body latency__note">Every measured edit stays below 100&nbsp;ms, at 1280×720 on 980 000 triangles.</p>
      </div>
    </div>

    <div class:list={['interactive__more', { 'interactive__more--plain': !compare }]}>
      {
        compare && (
          <div class="interactive__denoise" data-reveal="frame">
            <CompareSlider a="denoise-noisy" b="denoise-clean" labelA="16 samples" labelB="Denoised" ratio="16 / 10" name="Noisy and denoised comparison" />
          </div>
        )
      }
      <ul class="interactive__cards" data-reveal="stagger" data-stagger="0.1" data-focus>
        <li>
          <h3>OptiX denoiser</h3>
          <p>8&nbsp;ms at 1080p, 31&nbsp;ms at 4K on an RTX 5080.<Fn id="denoise" /></p>
        </li>
        <li>
          <h3>Adaptive sampling</h3>
          <p>About 3× faster at equal error on a glass scene, about even on uniformly noisy ones.<Fn id="adaptive" /></p>
        </li>
        <li>
          <h3>Look-dev tools</h3>
          <p>Outlines, headlight and dome overrides, simplified shading, path guiding.</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .interactive__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .viewport {
    border-radius: var(--radius);
    background: var(--stage);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .viewport__bar,
  .viewport__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
  }
  .viewport__bar .caption {
    text-transform: none;
    letter-spacing: 0;
    color: var(--faint);
  }
  .viewport__bar .viewport__stage {
    color: var(--paper);
  }
  .viewport__screen {
    position: relative;
    background: #0b0a09;
    border-block: 1px solid var(--line);
  }
  /* The live canvas replaces the flat one where WebGL 2 is available. */
  .viewport__screen .viewport__live,
  .viewport__hint,
  .viewport__note--live {
    display: none;
  }
  .viewport[data-live] .viewport__live {
    display: block;
    image-rendering: auto;
    cursor: grab;
    touch-action: pan-y;
  }
  .viewport[data-live] .viewport__live:active {
    cursor: grabbing;
  }
  .viewport[data-live] .viewport__flat,
  .viewport[data-live] .viewport__note--flat {
    display: none;
  }
  .viewport[data-live] .viewport__note--live {
    display: inline;
  }
  .viewport[data-live] .viewport__hint {
    display: block;
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    color: var(--paper);
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .viewport__hint[data-used] {
    opacity: 0;
  }
  .viewport__screen canvas {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    image-rendering: pixelated;
  }
  .viewport__foot {
    flex-wrap: wrap;
  }
  .viewport__note {
    flex: 1 1 16rem;
    text-align: right;
  }
  .viewport__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--nova);
  }

  .latency__title {
    text-transform: none;
    letter-spacing: 0;
    padding-bottom: 0.5rem;
  }
  .latency ul {
    display: grid;
  }
  .latency li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem 1rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--line);
  }
  .latency__edit {
    font-size: var(--text-sm);
    color: var(--paper-dim);
  }
  .latency__ms {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--paper);
  }
  .latency__bar {
    grid-column: 1 / -1;
    position: relative;
    height: 3px;
    background: var(--line);
    border-radius: 2px;
  }
  .latency__bar i {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: var(--paper);
    transform-origin: 0 50%;
    transform: scaleX(calc(var(--w) * var(--p, 1)));
  }
  .latency__scale {
    display: flex;
    justify-content: space-between;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
  }
  .latency__note {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .interactive__more {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-top: clamp(4rem, 9vw, 8rem);
  }
  .interactive__more--plain {
    grid-template-columns: minmax(0, 1fr);
  }
  .interactive__cards {
    display: grid;
  }
  .interactive__cards li {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 4fr);
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .interactive__cards h3 {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .interactive__cards p {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .interactive__grid,
    .interactive__more {
      grid-template-columns: minmax(0, 1fr);
    }
    .interactive__cards li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
  }
</style>
