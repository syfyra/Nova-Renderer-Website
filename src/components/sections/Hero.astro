---
// The hero and the opening statement share one pinned sequence.
//
// With WebGL 2 the wordmark is a solid object on a stage, path traced live in
// the browser: it resolves out of noise, the camera flies through the O past
// its light, and the statement is lit word by word. Without WebGL the 2D
// lockup below does the same in two dimensions (the mark resolves, the page
// zooms through the O).
import Wordmark from '../brand/Wordmark.astro';
import Icon from '../primitives/Icon.astro';
import RenderFrame from '../media/RenderFrame.astro';
import { hasRender } from '../../content/renders';
import { REPO_URL, VERSION, href } from '../../lib/site';

const withRender = hasRender('hero');
const statement =
  'Nova is a path tracer for Houdini’s Solaris. What you set up for Karma renders in Nova with the same look.';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__pin" data-hero-pin>
    <canvas class="hero__stage" data-hero-stage aria-hidden="true"></canvas>
    <div class="hero__shade" aria-hidden="true"></div>
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
    <i class="hero__ember" data-hero-ember aria-hidden="true"></i>

    {
      withRender && (
        <div class="hero__render" data-hero-render>
          <RenderFrame id="hero" fill eager sizes="100vw" />
          <div class="hero__scrim" />
        </div>
      )
    }

    <div class="hero__center">
      <h1 id="hero-title" class="sr-only">Nova: production path tracing for Houdini Solaris</h1>
      <div class="hero__lockup">
        <div class="hero__wordmark" data-hero-wm aria-hidden="true">
          <Wordmark id="hero-wm" />
        </div>
        <div class="hero__rule" data-hero-rule aria-hidden="true"></div>
        <div class="hero__copy" data-hero-copy>
          <p class="hero__tagline" data-hero-line>Production path tracing for Houdini Solaris</p>
          <p class="hero__sub" data-hero-line>Karma scenes, rendered the way Karma renders them, on the CPU and on NVIDIA GPUs</p>
          <div class="hero__cta" data-hero-line>
            <a class="btn btn--primary" href={href('/download')}>
              <span class="btn__dot" aria-hidden="true"></span>
              Download for Windows
            </a>
            <a class="btn" href={REPO_URL} rel="noopener">
              View on GitHub
              <Icon name="arrow-up-right" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__statement wrap" data-hero-statement>
      <p class="hero__statement-text" data-hero-words>{statement}</p>
    </div>

    <div class="hero__meta wrap" data-hero-meta>
      <p class="caption hero__spp">
        <span aria-hidden="true"><span data-hero-spp>4096</span> spp</span>
        <span class="hero__live" data-hero-live hidden>Path traced in your browser · not Nova</span>
      </p>
      <ul class="caption hero__facts">
        <li>v{VERSION}</li>
        <li>Houdini 22.0</li>
        <li>Windows x64</li>
        <li>MIT</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
  }
  .hero__pin {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 544px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  /* The live stage: the wordmark as an object, path traced in the browser. */
  .hero__stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 544px;
    display: none;
    pointer-events: none;
  }
  /* The reflection fades into the page, and the copy stays readable on it. */
  .hero__shade {
    position: absolute;
    inset: 0;
    display: none;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent calc(var(--base-px, 52vh) + 4px),
      rgb(16 15 13 / 0.82) calc(var(--base-px, 52vh) + 72px),
      var(--bg) calc(var(--base-px, 52vh) + 168px)
    );
  }
  .hero--stage .hero__stage,
  .hero--stage .hero__shade {
    display: block;
  }
  .hero--stage .hero__wordmark,
  .hero--stage .hero__rule,
  .hero--stage .hero__canvas {
    display: none;
  }
  /* The copy sits just below the wordmark's short reflection. */
  .hero--stage .hero__center {
    align-self: start;
    padding-top: calc(var(--base-px, 52vh) + 48px);
    padding-bottom: 0;
  }
  .hero--stage .hero__copy {
    padding-top: 0;
  }
  .hero__live {
    margin-left: 12px;
    padding-left: 12px;
    border-left: 1px solid var(--line-2);
  }
  /* The label that says what the picture is stays readable over any frame. */
  .hero--stage .hero__spp {
    justify-self: start;
    padding: 4px 8px;
    border-radius: var(--r-s);
    background: var(--surface);
    color: var(--text-2);
  }

  /* The light that stays when the camera has passed through the O: the dot. */
  .hero__ember {
    position: absolute;
    left: 50%;
    top: 24%;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--accent);
    pointer-events: none;
    visibility: hidden;
    z-index: 2;
  }

  /* 2D fallback: the wordmark resolves on a canvas, then the SVG takes over. */
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  .hero__render {
    position: absolute;
    inset: 0;
    clip-path: circle(0% at 50% 50%);
    z-index: 1;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(16 15 13 / 0.85), rgb(16 15 13 / 0.25) 45%, rgb(16 15 13 / 0.35));
    opacity: 0;
  }

  .hero__center {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-inline: var(--gutter);
    padding-bottom: 64px;
    display: grid;
    place-items: center;
  }
  .hero__lockup {
    width: min(100%, 1056px);
    display: grid;
    justify-items: center;
  }
  .hero__wordmark {
    width: 100%;
    color: var(--text);
  }
  .hero__rule {
    width: 100%;
    height: 1px;
    margin-top: 32px;
    background: var(--line-2);
    transform-origin: 50% 50%;
  }
  .hero__copy {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: 24px;
  }
  /* The line under the logo, set as it is on the logo card. */
  .hero__tagline {
    font-size: var(--t-24);
    line-height: 32px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text);
  }
  .hero__sub {
    margin-top: 12px;
    font-size: var(--t-16);
    line-height: 24px;
    color: var(--text-2);
    max-width: 34rem;
    text-wrap: balance;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__statement {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    align-items: center;
    padding-top: 18vh;
    pointer-events: none;
    visibility: hidden;
  }
  .hero__statement-text {
    max-width: 16em;
    margin-inline: auto;
    font-size: var(--h1);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-align: center;
    text-wrap: balance;
    color: var(--text);
  }

  .hero__meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
    max-width: none;
  }
  .hero__spp {
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .hero__facts {
    display: flex;
    gap: 8px 24px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* Before the intro runs: nothing but the stage. */
  :global(html.motion) .hero__wordmark,
  :global(html.motion) .hero__rule,
  :global(html.motion) [data-hero-line],
  :global(html.motion) .hero__meta {
    visibility: hidden;
  }

  /* Without motion the statement is an ordinary block below the hero. */
  :global(html:not(.motion)) .hero__pin {
    height: auto;
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + 48px);
    display: block;
  }
  :global(html:not(.motion)) .hero__center {
    min-height: calc(100svh - var(--nav-h) - 144px);
  }
  :global(html:not(.motion)) .hero__statement {
    position: relative;
    visibility: visible;
    padding-block: var(--section);
  }
  :global(html:not(.motion)) .hero__meta {
    position: relative;
  }
  :global(html:not(.motion)) .hero__spp {
    visibility: hidden;
  }
  :global(html:not(.motion)) .hero--stage .hero__pin {
    padding-top: 0;
  }
  :global(html:not(.motion)) .hero--stage .hero__center {
    align-items: start;
    min-height: calc(100svh - 80px);
  }
  :global(html:not(.motion)) .hero--stage .hero__spp {
    visibility: visible;
  }
  :global(html:not(.motion)) .hero__render {
    clip-path: none;
    opacity: 0.35;
  }

  @media (max-width: 760px) {
    .hero__meta {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    .hero__spp {
      display: none;
    }
    .hero__facts {
      gap: 4px 16px;
      justify-content: center;
    }
    .hero--stage .hero__spp {
      display: block;
      order: 2;
      text-align: center;
      justify-self: center;
      white-space: normal;
    }
    .hero--stage .hero__live {
      display: block;
      margin: 4px 0 0;
      padding: 0;
      border: 0;
    }
    .hero--stage .hero__center {
      padding-top: calc(var(--base-px, 36vh) + 32px);
    }
    .hero__statement {
      padding-top: 12vh;
    }
  }
</style>
