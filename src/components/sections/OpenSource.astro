---
import { getGitHub } from '../../lib/github';
import { REPO, REPO_URL, source } from '../../lib/site';

const gh = await getGitHub();
const links = [
  { label: 'Reference', note: 'Every setting, every measured difference to Karma.', url: source('docs/reference.md') },
  { label: 'Design notes', note: 'One per milestone, M3 to M11.', url: source('docs/design/') },
  { label: 'Benchmarks', note: 'The raw measurements.', url: source('docs/benchmarks.md') },
  { label: 'Bug audit', note: 'Findings, fixes and what remains.', url: source('docs/bug-audit-2026-11.md') },
];
---

<section class="section oss" id="source" aria-labelledby="oss-title">
  <div class="wrap">
    <div class="oss__grid">
      <header class="oss__lead">
        <p class="eyebrow" data-reveal="fade"><b>12</b> Open source</p>
        <h2 id="oss-title" class="display-2" data-reveal="lines">Read every line.</h2>
        <p class="lede" data-reveal="fade">MIT licensed. Built milestone by milestone, with a design note for each one.</p>
        <a class="oss__repo" href={REPO_URL} rel="noopener" data-reveal="fade">
          <svg viewBox="0 0 16 16" aria-hidden="true" class="oss__gh"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          <span class="oss__name mono">{REPO}</span>
          <span class="oss__meta caption">
            {gh.stars !== null && <span>★ {gh.stars.toLocaleString('en')}</span>}
            <span>v{gh.version}</span>
            <span>MIT</span>
          </span>
          <svg viewBox="0 0 12 12" aria-hidden="true" class="oss__arrow"><path d="M3 9l6-6M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
        </a>
      </header>

      <ul class="oss__links" data-reveal="stagger" data-stagger="0.08" data-focus>
        {
          links.map((l) => (
            <li>
              <a href={l.url} rel="noopener">
                <span class="oss__label">{l.label}</span>
                <span class="oss__note">{l.note}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .oss__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: end;
  }
  .oss__lead {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .oss__repo {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.75rem;
    padding: 0.9rem 1.2rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      box-shadow 0.3s,
      transform 0.4s var(--ease-out);
    max-width: 100%;
  }
  .oss__repo:hover {
    box-shadow: inset 0 0 0 1px rgb(239 233 222 / 0.5);
    transform: translateY(-2px);
  }
  .oss__gh {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
  .oss__name {
    font-size: var(--text-sm);
  }
  .oss__meta {
    display: inline-flex;
    gap: 0.75rem;
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-strong);
  }
  .oss__arrow {
    width: 0.75rem;
    height: 0.75rem;
    color: var(--muted);
  }
  .oss__links a {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 4fr) auto;
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 1.15rem;
    border-top: 1px solid var(--line);
    transition: padding 0.4s var(--ease-out);
  }
  .oss__links li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .oss__links a:hover {
    padding-left: 0.6rem;
  }
  .oss__label {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .oss__note {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .oss__links svg {
    width: 0.7rem;
    height: 0.7rem;
    color: var(--faint);
    transition:
      color 0.2s,
      transform 0.4s var(--ease-out);
  }
  .oss__links a:hover svg {
    color: var(--nova);
    transform: translate(0.15rem, -0.15rem);
  }
  @media (max-width: 900px) {
    .oss__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .oss__links a {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .oss__note {
      grid-column: 1;
      grid-row: 2;
    }
    .oss__meta {
      display: none;
    }
  }
</style>
