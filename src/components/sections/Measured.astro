---
import Fn from '../primitives/Fn.astro';
import Icon from '../primitives/Icon.astro';
import { href, source } from '../../lib/site';
---

<section class="section measured" id="measured" aria-labelledby="measured-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow" data-reveal>Verification</p>
      <h2 id="measured-title" class="display-2" data-words>Every feature is measured against Karma CPU or an analytic value</h2>
      <p class="lede" data-reveal>The differences that remain are written down</p>
    </header>

    <ul class="facts" data-stagger>
      <li class="fact">
        <p class="fact__value">≈ <span data-count>690</span></p>
        <p class="fact__label">automated tests<Fn id="tests" /></p>
      </li>
      <li class="fact">
        <p class="fact__value"><span data-count>12</span><small>of 12</small></p>
        <p class="fact__label">visible Karma LOPs, each checked by a test</p>
      </li>
      <li class="fact">
        <p class="fact__value"><span data-count>740</span><small>of 746</small></p>
        <p class="fact__label">MaterialX 1.39 node definitions</p>
      </li>
      <li class="fact">
        <p class="fact__value"><span data-count>71</span></p>
        <p class="fact__label">defects found and fixed in the November 2026 audit<Fn id="audit" /></p>
      </li>
    </ul>

    <p class="measured__links" data-reveal>
      <a class="arrow" href={href('/benchmarks')}>Read the benchmarks <Icon name="arrow-right" /></a>
      <a class="arrow" href={source('docs/bug-audit-2026-11.md')} rel="noopener">Read the bug audit <Icon name="arrow-up-right" /></a>
    </p>
  </div>
</section>

<style>
  .measured__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 32px;
  }
</style>
