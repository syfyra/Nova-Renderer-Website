---
import Fn from '../primitives/Fn.astro';
import Icon from '../primitives/Icon.astro';
import { href, source } from '../../lib/site';
---

<section class="section measured" id="measured" aria-labelledby="measured-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Verification</p>
      <h2 id="measured-title" class="display-2">Measured against Karma CPU, feature by feature</h2>
      <p class="lede">
        Every feature is measured against Karma CPU or an analytic value, and the differences that remain are written
        down. The same scene renders the same image, run to run and on CPU and GPU alike.
      </p>
    </header>

    <ul class="facts">
      <li class="fact">
        <p class="fact__value">≈ 690</p>
        <p class="fact__label">automated tests: unit tests, husk renders, statistical comparisons against Karma, isolated Houdini sessions<Fn id="tests" /></p>
      </li>
      <li class="fact">
        <p class="fact__value">12<small>of 12</small></p>
        <p class="fact__label">visible Karma LOPs, each measured against Karma CPU and checked by an automated test</p>
      </li>
      <li class="fact">
        <p class="fact__value">740<small>of 746</small></p>
        <p class="fact__label">MaterialX 1.39 node definitions in the shading compiler</p>
      </li>
      <li class="fact">
        <p class="fact__value">71</p>
        <p class="fact__label">verified defects found and fixed in the November 2026 audit<Fn id="audit" /></p>
      </li>
    </ul>

    <p class="measured__links">
      <a class="arrow" href={href('/benchmarks')}>Read the benchmarks <Icon name="arrow-right" /></a>
      <a class="arrow" href={source('docs/bug-audit-2026-11.md')} rel="noopener">Read the bug audit <Icon name="arrow-up-right" /></a>
    </p>
  </div>
</section>

<style>
  .measured__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 32px;
  }
</style>
