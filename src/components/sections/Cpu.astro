---
// Chapter four: speed on the CPU, with the same shape as the GPU chapter.
import Fn from '../primitives/Fn.astro';
---

<section class="section cpu" id="cpu" aria-labelledby="cpu-title">
  <div class="wrap cpu__grid">
    <header class="cpu__lead">
      <p class="eyebrow" data-reveal>On the CPU</p>
      <h2 id="cpu-title" class="figure" data-drift="20">
        <span class="sr-only">21 to 38 million rays per second on the CPU</span>
        <span aria-hidden="true" data-count>21–38</span>
      </h2>
      <p class="figure-claim" data-reveal>million rays per second on the reference scenes, on eight cores<Fn id="cpu-rays" /></p>
    </header>

    <dl class="cpu__rows" data-stagger data-focus>
      <div>
        <dt>Embree 4</dt>
        <dd>AVX2, instance arrays, and a BVH that refits for deforming meshes</dd>
      </div>
      <div>
        <dt>Wavefront integrator</dt>
        <dd>Owen-scrambled Sobol sequences, multiple importance sampling and a light tree</dd>
      </div>
      <div>
        <dt>SIMD shading VM</dt>
        <dd>A value edit never recompiles, a structural edit recompiles one material in about 0.1&nbsp;ms<Fn id="shading-edit" /></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .cpu__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px var(--gap-xl);
    align-items: end;
  }
  .cpu__lead {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .cpu__rows {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  .cpu__rows > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 4fr);
    gap: 8px 24px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .cpu__rows dt {
    font-weight: 500;
    line-height: 24px;
  }
  .cpu__rows dd {
    margin: 0;
    color: var(--text-2);
    font-size: var(--t-14);
    line-height: 20px;
    align-self: center;
  }
  @media (max-width: 900px) {
    .cpu__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cpu__rows > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
