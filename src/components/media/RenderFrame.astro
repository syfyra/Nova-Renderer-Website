---
// A showcase slot. With an image in src/assets/renders/<id>.* it renders the
// picture with its metadata caption. Without one it is a plain surface of the
// right size and nothing else, so nothing unfinished can ship by accident;
// production builds leave empty slots out altogether.
import { Picture } from 'astro:assets';
import { SHOW_PENDING, captionOf, getRender, type SlotId } from '../../content/renders';

interface Props {
  id: SlotId;
  class?: string;
  /** Hide the caption (used inside comparison sliders, which carry labels). */
  bare?: boolean;
  /** Fill the parent instead of taking the image's own aspect ratio. */
  fill?: boolean;
  ratio?: string;
  sizes?: string;
  eager?: boolean;
}
const {
  id,
  class: className,
  bare = false,
  fill = false,
  ratio = '16 / 9',
  sizes = '(min-width: 1500px) 1400px, 100vw',
  eager = false,
} = Astro.props;
const { meta, image } = getRender(id);
const show = Boolean(image) || SHOW_PENDING;
---

{show && (
<figure
  class:list={['frame', className, { 'frame--fill': fill }]}
  style={fill ? undefined : `aspect-ratio:${ratio}`}
  data-frame={id}
  title={image ? undefined : `${meta.shot}: ${meta.brief}`}
>
  {
    image && (
      <>
        <Picture
          src={image}
          alt={meta.alt ?? `${meta.title}, rendered with ${meta.renderer}`}
          formats={['avif', 'webp']}
          widths={[640, 960, 1440, 1920, 2560, image.width].filter((w, i, a) => w <= image.width && a.indexOf(w) === i)}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
          class="frame__img"
        />
        {!bare && (
          <figcaption class="caption frame__caption">
            {captionOf(meta)}
            {meta.credit && <span> · {meta.credit}</span>}
          </figcaption>
        )}
      </>
    )
  }
</figure>
)}

<style>
  .frame {
    position: relative;
    width: 100%;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .frame--fill {
    position: absolute;
    inset: 0;
    border-radius: 0;
    height: 100%;
    box-shadow: none;
  }
  .frame :global(picture) {
    display: contents;
  }
  .frame :global(.frame__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame__caption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 4px 8px;
    border-radius: var(--r-s);
    background: var(--surface);
    color: var(--text-2);
  }
</style>
