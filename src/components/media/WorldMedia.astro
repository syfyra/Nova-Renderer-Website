---
// The picture behind a full-height panel, or a viewfinder frame that says
// which picture belongs there.
import RenderFrame from './RenderFrame.astro';
import { SHOW_PENDING, hasRender, slots, type SlotId } from '../../content/renders';

interface Props {
  id: SlotId;
}
const { id } = Astro.props;
const has = hasRender(id);
---

{
  has ? (
    <div class="wm-media">
      <RenderFrame id={id} fill sizes="100vw" />
    </div>
  ) : (
    SHOW_PENDING && (
      <div class="wm-finder" aria-hidden="true">
        <i /><i /><i /><i />
        <p class="caption">
          {slots[id].shot} · render pending<br />
          <span>{slots[id].brief}</span>
        </p>
      </div>
    )
  )
}

<style>
  .wm-media {
    position: absolute;
    inset: 0;
  }
  .wm-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 10 10 / 0.92), rgb(10 10 10 / 0.25) 55%, rgb(10 10 10 / 0.4));
  }
  .wm-finder {
    position: absolute;
    inset: calc(var(--nav-h) + 1.25rem) var(--gutter) 1.25rem;
    pointer-events: none;
  }
  .wm-finder i {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--line-strong);
  }
  .wm-finder i:nth-child(1) {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .wm-finder i:nth-child(2) {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .wm-finder i:nth-child(3) {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .wm-finder i:nth-child(4) {
    bottom: 0;
    right: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  .wm-finder p {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .wm-finder span {
    text-transform: none;
    letter-spacing: 0.01em;
    color: var(--faint);
  }
  @media (max-width: 760px) {
    .wm-finder {
      inset: 1rem var(--gutter);
    }
    .wm-finder p {
      top: 1rem;
      right: 1.25rem;
    }
    .wm-finder span,
    .wm-finder br {
      display: none;
    }
  }
</style>
