---
// Two frames of the same picture under a draggable divider.
// Pointer, touch and keyboard (arrow keys, Home, End) move it.
import RenderFrame from './RenderFrame.astro';
import Icon from '../primitives/Icon.astro';
import { slotVisible, type SlotId } from '../../content/renders';

interface Props {
  a: SlotId;
  b: SlotId;
  labelA: string;
  labelB: string;
  ratio?: string;
  name: string;
}
const { a, b, labelA, labelB, ratio = '16 / 9', name } = Astro.props;
const show = slotVisible(a, b);
---

{show && (
<div class="compare" data-compare style={`aspect-ratio:${ratio}; --pos:50%`}>
  <div class="compare__layer">
    <RenderFrame id={a} fill bare />
  </div>
  <div class="compare__layer compare__layer--b">
    <RenderFrame id={b} fill bare />
  </div>
  <span class="compare__chip compare__chip--a caption">{labelA}</span>
  <span class="compare__chip compare__chip--b caption">{labelB}</span>
  <div
    class="compare__handle"
    role="slider"
    tabindex="0"
    aria-label={`${name}: share of the picture showing ${labelA}`}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-orientation="horizontal"
    data-compare-handle
  >
    <span class="compare__grip" aria-hidden="true"><Icon name="chevrons-left-right" /></span>
  </div>
</div>
)}

<style>
  .compare {
    position: relative;
    width: 100%;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
  }
  .compare__layer {
    position: absolute;
    inset: 0;
  }
  .compare__layer--b {
    clip-path: inset(0 0 0 var(--pos));
  }
  .compare__layer--b :global(.frame) {
    background: var(--raised);
  }
  .compare__chip {
    position: absolute;
    top: 12px;
    padding: 4px 8px;
    border-radius: var(--r-s);
    background: var(--bg);
    color: var(--text);
    pointer-events: none;
    z-index: 2;
  }
  .compare__chip--a {
    left: 12px;
  }
  .compare__chip--b {
    right: 12px;
  }
  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 44px;
    margin-left: -22px;
    display: grid;
    place-items: center;
    z-index: 3;
    outline-offset: -4px;
  }
  .compare__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--text);
  }
  .compare__grip {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: var(--r-m);
    display: grid;
    place-items: center;
    background: var(--text);
    color: var(--bg);
  }
</style>
