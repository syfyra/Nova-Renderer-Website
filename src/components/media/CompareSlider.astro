---
// Two frames of the same picture under a draggable divider.
// Pointer, touch and keyboard (arrow keys, Home, End) move it.
import RenderFrame from './RenderFrame.astro';
import { slotVisible, type SlotId } from '../../content/renders';

interface Props {
  a: SlotId;
  b: SlotId;
  labelA: string;
  labelB: string;
  ratio?: string;
  name: string;
}
const { a, b, labelA, labelB, ratio = '16 / 9', name } = Astro.props;
const show = slotVisible(a, b);
---

{show && (
<div class="compare" data-compare style={`aspect-ratio:${ratio}; --pos:50%`}>
  <div class="compare__layer compare__layer--a">
    <RenderFrame id={a} fill bare align="start" />
  </div>
  <div class="compare__layer compare__layer--b">
    <RenderFrame id={b} fill bare align="end" />
  </div>
  <span class="compare__chip compare__chip--a glass caption">{labelA}</span>
  <span class="compare__chip compare__chip--b glass caption">{labelB}</span>
  <div
    class="compare__handle"
    role="slider"
    tabindex="0"
    aria-label={`${name}: share of the picture showing ${labelA}`}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-orientation="horizontal"
    data-compare-handle
  >
    <span class="compare__grip glass" aria-hidden="true">
      <svg viewBox="0 0 20 20"><path d="M7.5 6 3.5 10l4 4M12.5 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </span>
  </div>
</div>
)}

<style>
  .compare {
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stage);
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .compare__layer {
    position: absolute;
    inset: 0;
  }
  .compare__layer--b {
    clip-path: inset(0 0 0 var(--pos));
  }
  .compare__layer--b :global(.frame--empty) {
    background: var(--stage-2);
  }
  .compare :global(.frame__tick) {
    display: none;
  }
  .compare__chip {
    position: absolute;
    top: 1rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    color: var(--paper);
    pointer-events: none;
    z-index: 2;
  }
  .compare__chip--a {
    left: 1rem;
  }
  .compare__chip--b {
    right: 1rem;
  }
  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 44px;
    margin-left: -22px;
    display: grid;
    place-items: center;
    z-index: 3;
    outline-offset: -4px;
  }
  .compare__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: rgb(239 233 222 / 0.7);
  }
  .compare__grip {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--paper);
    transition: transform 0.4s var(--ease-out);
  }
  .compare__grip svg {
    width: 20px;
    height: 20px;
  }
  .compare:hover .compare__grip,
  .compare__handle:focus-visible .compare__grip {
    transform: scale(1.08);
  }
</style>
