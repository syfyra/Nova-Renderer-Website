---
// A command block with a copy button. `lines` are shown one per row; the
// button copies them joined by newlines.
interface Props {
  lines: string[];
  label?: string;
  prompt?: string;
}
const { lines, label = 'Command', prompt = '>' } = Astro.props;
---

<figure class="code" data-code>
  <figcaption>
    <span class="caption">{label}</span>
    <button type="button" class="code__copy caption" data-copy={lines.join('\n')}>
      <span data-copy-label>Copy</span>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </button>
  </figcaption>
  <pre tabindex="0"><code>{lines.map((l) => (<span class="code__line"><span class="code__prompt" aria-hidden="true">{prompt}</span>{l}{'\n'}</span>))}</code></pre>
</figure>

<style>
  .code {
    border-radius: var(--r-m);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 8px 8px 16px;
    border-bottom: 1px solid var(--line);
  }
  .code__copy {
    padding: 4px 8px;
    border-radius: var(--r-s);
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--text-2);
    transition: color 160ms var(--ease);
  }
  .code__copy:hover,
  .code__copy[data-done] {
    color: var(--text);
  }
  pre {
    margin: 0;
    padding: 12px 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--t-14);
    line-height: 24px;
    color: var(--text);
    font-variant-ligatures: none;
  }
  .code__line {
    display: block;
    white-space: pre;
  }
  .code__prompt {
    display: inline-block;
    width: 20px;
    color: var(--text-3);
    user-select: none;
  }
</style>
