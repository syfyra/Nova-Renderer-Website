---
// Paired horizontal bars: a baseline and the measured value, per row. The
// baseline sits in a neutral step of the ramp; the series that matters
// carries the accent. A real table for assistive technology sits underneath.
export interface BarRow {
  label: string;
  sub?: string;
  a: number;
  b: number;
  ratio?: string;
}
interface Props {
  rows: BarRow[];
  nameA: string;
  nameB: string;
  unit: string;
  decimalsA?: number;
  decimalsB?: number;
  caption: string;
  /** Which side carries the accent. */
  accent?: 'a' | 'b';
}
const { rows, nameA, nameB, unit, decimalsA = 1, decimalsB = 2, caption, accent = 'b' } = Astro.props;
const max = Math.max(...rows.flatMap((r) => [r.a, r.b]));
---

<figure class="bench">
  <div class="bench__rows" aria-hidden="true">
    {
      rows.map((r) => (
        <div class="bench__row">
          <div class="bench__head">
            <p>
              <span class="mono bench__scene">{r.label}</span>
              {r.sub && <span class="bench__sub">{r.sub}</span>}
            </p>
            {r.ratio && <p class="bench__ratio num">{r.ratio}</p>}
          </div>
          <div class="bench__line">
            <span class="caption">{nameA}</span>
            <span class:list={['bench__bar', { 'bench__bar--accent': accent === 'a' }]}>
              <i style={`--w:${(r.a / max).toFixed(4)}`} />
            </span>
            <span class="caption num bench__val">
              {r.a.toFixed(decimalsA)} {unit}
            </span>
          </div>
          <div class="bench__line">
            <span class="caption">{nameB}</span>
            <span class:list={['bench__bar', { 'bench__bar--accent': accent === 'b' }]}>
              <i style={`--w:${(r.b / max).toFixed(4)}`} />
            </span>
            <span class="caption num bench__val">
              {r.b.toFixed(decimalsB)} {unit}
            </span>
          </div>
        </div>
      ))
    }
  </div>
  <div class="sr-only">
    <table>
      <caption>{caption}</caption>
      <thead>
        <tr><th>Scene</th><th>{nameA} ({unit})</th><th>{nameB} ({unit})</th><th>Ratio</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (<tr><th>{r.label}{r.sub ? `, ${r.sub}` : ''}</th><td>{r.a}</td><td>{r.b}</td><td>{r.ratio}</td></tr>))}
      </tbody>
    </table>
  </div>
  <figcaption class="caption"><slot>{caption}</slot></figcaption>
</figure>

<style>
  .bench__row {
    display: grid;
    gap: 8px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }
  .bench__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .bench__scene {
    color: var(--text);
    font-size: var(--t-14);
  }
  .bench__sub {
    margin-left: 12px;
    font-size: var(--t-14);
    color: var(--text-2);
  }
  .bench__ratio {
    font-size: var(--t-18);
    font-weight: 500;
  }
  .bench__line {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 72px;
    align-items: center;
    gap: 12px;
  }
  .bench__val {
    text-align: right;
    color: var(--text-2);
  }
  .bench__bar {
    position: relative;
    height: 4px;
  }
  .bench__bar i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: 2px;
    background: var(--mark);
    transform-origin: 0 50%;
    transform: scaleX(var(--w));
  }
  .bench__bar--accent i {
    background: var(--accent);
  }
  figcaption {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    max-width: 44em;
  }
  @media (max-width: 560px) {
    .bench__sub {
      display: block;
      margin: 4px 0 0;
    }
  }
</style>
