---
// The compatibility checklist. Shown beside every download action.
const items = [
  { k: 'System', v: 'Windows 10 or 11, x64' },
  { k: 'Host', v: 'Houdini 22.0' },
  { k: 'CPU', v: 'Any processor with AVX2' },
  { k: 'Nova XPU', v: 'NVIDIA RTX 50 series with a current driver. Other machines render on the CPU.' },
];
---

<dl class="req">
  {
    items.map((i) => (
      <div>
        <dt>{i.k}</dt>
        <dd>{i.v}</dd>
      </div>
    ))
  }
</dl>

<style>
  .req {
    margin: 0;
  }
  .req > div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
    font-size: var(--t-14);
    line-height: 20px;
  }
  .req > div:last-child {
    border-bottom: 1px solid var(--line);
  }
  dt {
    color: var(--text-3);
  }
  dd {
    margin: 0;
    color: var(--text);
  }
</style>
