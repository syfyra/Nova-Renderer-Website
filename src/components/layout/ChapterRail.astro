---
// The story's thread: one mark per chapter at the edge of the page, and the
// logo's dot on the chapter in view. Wide screens only; the marks are links.
// motion/home.ts moves the dot.
const chapters = [
  ['karma', 'Scene'],
  ['devices', 'Devices'],
  ['xpu', 'GPU'],
  ['cpu', 'CPU'],
  ['materials', 'Materials'],
  ['light', 'Light'],
  ['output', 'Passes'],
  ['interactive', 'Viewport'],
  ['measured', 'Proof'],
  ['not-yet', 'Limits'],
  ['get-started', 'Install'],
  ['source', 'Source'],
] as const;
---

<nav class="rail" aria-label="Chapters" data-rail>
  <ol>
    {
      chapters.map(([id, label]) => (
        <li>
          <a href={`#${id}`} data-rail-link={id}>
            <i aria-hidden="true" />
            <span>{label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .rail {
    position: fixed;
    left: 12px;
    top: 50%;
    z-index: 50;
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 400ms var(--ease),
      visibility 400ms;
  }
  .rail[data-on] {
    opacity: 1;
    visibility: visible;
  }
  a {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 20px;
    padding-inline: 12px;
  }
  /* A mark: a short line that becomes the dot on the chapter in view. */
  i {
    width: 8px;
    height: 1px;
    border-radius: 4px;
    background: var(--text-3);
    transition:
      width 300ms var(--ease),
      height 300ms var(--ease),
      background-color 300ms var(--ease);
  }
  a:hover i {
    width: 16px;
    background: var(--text);
  }
  a[aria-current] i {
    width: 8px;
    height: 8px;
    background: var(--accent);
  }
  span {
    padding: 4px 8px;
    border-radius: var(--r-s);
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: var(--t-12);
    line-height: 16px;
    color: var(--text);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 200ms var(--ease),
      transform 200ms var(--ease);
    pointer-events: none;
  }
  a:hover span,
  a:focus-visible span {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 1199px) {
    .rail {
      display: none;
    }
  }
</style>
