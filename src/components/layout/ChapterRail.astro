---
// An addition to the page, not a replacement for anything: one mark per
// chapter at the left edge of wide screens, and the logo's dot on the chapter
// in view. The marks are links. motion/home.ts moves the dot.
const chapters = [
  ['devices', 'Two renderers'],
  ['xpu', 'Nova XPU'],
  ['cpu', 'On the CPU'],
  ['karma', 'Karma'],
  ['materials', 'Materials'],
  ['light', 'Light and matter'],
  ['output', 'Output'],
  ['interactive', 'Look-dev'],
  ['measured', 'Verification'],
  ['not-yet', 'Limitations'],
  ['get-started', 'Get started'],
  ['source', 'Open source'],
] as const;
---

<nav class="rail" aria-label="Chapters" data-rail>
  <ol>
    {
      chapters.map(([id, label]) => (
        <li>
          <a href={`#${id}`} data-rail-link={id}>
            <i aria-hidden="true" />
            <span>{label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .rail {
    position: fixed;
    left: 0.5rem;
    top: 50%;
    z-index: 90;
    translate: 0 -50%;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s var(--ease-out),
      visibility 0.5s;
  }
  .rail[data-on] {
    opacity: 1;
    visibility: visible;
  }
  /* The link is only as wide as its mark; the label hangs beside it and never
     takes the pointer from the page. */
  a {
    position: relative;
    display: flex;
    align-items: center;
    width: 2.5rem;
    height: 1.25rem;
    padding-inline: 0.75rem;
  }
  /* A mark: a short line that becomes the dot on the chapter in view. */
  i {
    width: 0.5rem;
    height: 1px;
    border-radius: 0.25rem;
    background: var(--faint);
    transition:
      width 0.4s var(--ease-out),
      height 0.4s var(--ease-out),
      background-color 0.4s var(--ease-out);
  }
  a:hover i {
    width: 1rem;
    background: var(--paper);
  }
  a[aria-current] i {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--nova);
  }
  span {
    position: absolute;
    left: 100%;
    top: 50%;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-s);
    background: var(--stage-3);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    color: var(--paper);
    white-space: nowrap;
    opacity: 0;
    translate: -0.25rem -50%;
    transition:
      opacity 0.25s var(--ease-out),
      translate 0.25s var(--ease-out);
    pointer-events: none;
  }
  a:hover span,
  a:focus-visible span {
    opacity: 1;
    translate: 0 -50%;
  }
  @media (max-width: 1199px) {
    .rail {
      display: none;
    }
  }
</style>
