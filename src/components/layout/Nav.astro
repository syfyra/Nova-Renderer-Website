---
import Wordmark from '../brand/Wordmark.astro';
import { NAV, REPO_URL, href } from '../../lib/site';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = path.startsWith(base) ? path.slice(base.length) || '/' : path;
const isCurrent = (p: string) => (p === '/' ? rel === '/' : rel.startsWith(p));
---

<header class="nav" data-nav data-overlay={overlay ? '' : undefined}>
  <div class="nav__bar wrap">
    <a class="nav__brand" href={href('/')} aria-label="Nova, home">
      <Wordmark id="nav-wm" glow={false} label="Nova" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={REPO_URL} rel="noopener" data-ext>
        GitHub
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      </a>
    </nav>

    <div class="nav__actions">
      <a class="btn btn--primary btn--small" href={href('/download')}>
        <span class="btn__dot" aria-hidden="true"></span>
        Download
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <span class="nav__toggle-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__menu" id="nav-menu" data-nav-menu hidden>
    <nav class="wrap" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={REPO_URL} rel="noopener">GitHub</a>
      <a href={href('/download')}>Download</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.4s,
      box-shadow 0.4s;
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: rgb(12 12 11 / 0.62);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
    backdrop-filter: blur(22px) saturate(1.5);
    box-shadow: inset 0 -1px 0 0 var(--line);
    transition: opacity 0.4s;
  }
  .nav:not([data-overlay])::before,
  .nav.is-scrolled::before,
  .nav.is-open::before {
    opacity: 1;
  }
  .nav.is-hidden:not(.is-open) {
    transform: translateY(-100%);
  }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--nav-h);
  }

  .nav__brand {
    display: block;
    width: 4.4rem;
    color: var(--paper);
    flex: none;
    padding-block: 0.5rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.5rem);
    margin-left: auto;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .nav__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding-block: 0.5rem;
    color: var(--muted);
    transition: color 0.25s;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--paper);
  }
  .nav__links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 3px;
    height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: var(--nova);
  }
  .nav__links svg {
    width: 0.7em;
    height: 0.7em;
    opacity: 0.7;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav__toggle {
    display: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    place-items: center;
  }
  .nav__toggle-lines {
    position: relative;
    display: block;
    width: 14px;
    height: 8px;
  }
  .nav__toggle-lines i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--paper);
    transition: transform 0.4s var(--ease-out);
  }
  .nav__toggle-lines i:first-child {
    top: 0;
  }
  .nav__toggle-lines i:last-child {
    bottom: 0;
  }
  .nav.is-open .nav__toggle-lines i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav.is-open .nav__toggle-lines i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav__menu {
    border-top: 1px solid var(--line);
    padding-block: 1rem 2rem;
  }
  .nav__menu nav {
    display: grid;
  }
  .nav__menu a {
    padding: 0.85rem 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    border-bottom: 1px solid var(--line);
    color: var(--paper-dim);
  }
  .nav__menu a[aria-current='page'] {
    color: var(--paper);
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: grid;
    }
  }
  @media (min-width: 761px) {
    .nav__menu {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  if (nav) {
    let last = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-scrolled', y > 40);
      // Hide while reading down, return on the way up.
      if (Math.abs(y - last) > 6) {
        nav.classList.toggle('is-hidden', y > last && y > 400);
        last = y;
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (menu) menu.hidden = !open;
    };
    toggle?.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
    menu?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
