---
import Wordmark from '../brand/Wordmark.astro';
import { NAV, REPO_URL, href } from '../../lib/site';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = path.startsWith(base) ? path.slice(base.length) || '/' : path;
const isCurrent = (p: string) => (p === '/' ? rel === '/' : rel.startsWith(p));
---

<header class="nav" data-nav data-overlay={overlay ? '' : undefined}>
  <div class="nav__bar wrap">
    <a class="nav__brand" href={href('/')} aria-label="Nova, home">
      <Wordmark id="nav-wm" glow={false} label="Nova" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={REPO_URL} rel="noopener">GitHub</a>
    </nav>

    <div class="nav__actions">
      <a class="btn btn--primary btn--small" href={href('/download')}>Download</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <span class="nav__toggle-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__menu" id="nav-menu" data-nav-menu hidden>
    <nav class="wrap" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={REPO_URL} rel="noopener">GitHub</a>
      <a href={href('/download')}>Download</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: var(--bg);
    box-shadow: inset 0 -1px 0 0 var(--line);
    transition:
      transform 300ms var(--ease),
      background-color 160ms var(--ease),
      box-shadow 160ms var(--ease);
  }
  /* Over the hero the bar is clear until the page moves. */
  .nav[data-overlay]:not(.is-scrolled):not(.is-open) {
    background: transparent;
    box-shadow: none;
  }
  .nav.is-hidden:not(.is-open) {
    transform: translateY(-100%);
  }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--nav-h);
  }

  .nav__brand {
    display: block;
    width: 72px;
    color: var(--text);
    flex: none;
    padding-block: 8px;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-left: auto;
    font-size: var(--t-14);
  }
  .nav__links a {
    padding-block: 8px;
    color: var(--text-2);
    transition: color 160ms var(--ease);
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--text);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav__toggle {
    display: none;
    width: 36px;
    height: 36px;
    border-radius: var(--r-m);
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line-2);
    place-items: center;
  }
  .nav__toggle-lines {
    position: relative;
    display: block;
    width: 16px;
    height: 8px;
  }
  .nav__toggle-lines i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--text);
    transition: transform 160ms var(--ease);
  }
  .nav__toggle-lines i:first-child {
    top: 0;
  }
  .nav__toggle-lines i:last-child {
    bottom: 0;
  }
  .nav.is-open .nav__toggle-lines i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav.is-open .nav__toggle-lines i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav__menu {
    border-top: 1px solid var(--line);
    padding-block: 8px 24px;
  }
  .nav__menu nav {
    display: grid;
  }
  .nav__menu a {
    padding: 12px 0;
    font-size: var(--t-18);
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
  }
  .nav__menu a[aria-current='page'] {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: grid;
    }
  }
  @media (min-width: 761px) {
    .nav__menu {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  if (nav) {
    let last = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-scrolled', y > 40);
      // Out of the way while reading down, back on the way up.
      if (Math.abs(y - last) > 6) {
        nav.classList.toggle('is-hidden', y > last && y > 400);
        last = y;
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (menu) menu.hidden = !open;
    };
    toggle?.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
    menu?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
