---
import { claims } from '../../content/claims';
import { homeNotes } from '../../content/notes';
import { SOURCE_TAG } from '../../lib/site';
---

<section class="notes" aria-labelledby="notes-title">
  <div class="wrap">
    <h2 id="notes-title" class="eyebrow">Footnotes, measured on Nova {SOURCE_TAG}</h2>
    <ol>
      {
        homeNotes.map((id, i) => (
          <li id={`fn-${i + 1}`}>
            <span class="caption num">{i + 1}</span>
            <p>
              {claims[id].note}{' '}
              <a href={claims[id].src.url} rel="noopener" class="link mono">{claims[id].src.label}</a>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .notes {
    padding-block: 64px;
    border-top: 1px solid var(--line);
  }
  ol {
    margin-top: 24px;
    columns: 2;
    column-gap: var(--gap-l);
    font-size: var(--t-12);
    line-height: 20px;
    color: var(--text-2);
  }
  li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    break-inside: avoid;
    padding-bottom: 12px;
    scroll-margin-top: 96px;
  }
  li .caption {
    line-height: 20px;
  }
  li:target p {
    color: var(--text);
  }
  @media (max-width: 760px) {
    ol {
      columns: 1;
    }
  }
</style>
