---
import { claims } from '../../content/claims';
import { homeNotes } from '../../content/notes';
import { SOURCE_TAG } from '../../lib/site';
---

<section class="notes" aria-labelledby="notes-title">
  <div class="wrap">
    <h2 id="notes-title" class="caption">Footnotes · measured on Nova {SOURCE_TAG}</h2>
    <ol>
      {
        homeNotes.map((id, i) => (
          <li id={`fn-${i + 1}`}>
            <span class="notes__n mono">{i + 1}</span>
            <p>
              {claims[id].note}{' '}
              <a href={claims[id].src.url} rel="noopener" class="notes__src mono">
                {claims[id].src.label} ↗
              </a>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .notes {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
    background: var(--ink);
    position: relative;
    z-index: 2;
  }
  h2 {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--faint);
    margin-bottom: 1.75rem;
  }
  ol {
    columns: 2;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--muted);
  }
  li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    break-inside: avoid;
    padding-bottom: 0.9rem;
    scroll-margin-top: 6rem;
  }
  li:target p {
    color: var(--paper);
  }
  .notes__n {
    color: var(--faint);
  }
  .notes__src {
    color: var(--paper-dim);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .notes__src:hover {
    color: var(--nova);
  }
  @media (max-width: 760px) {
    ol {
      columns: 1;
    }
  }
</style>
