---
import { claims } from '../../content/claims';
import { homeNotes } from '../../content/notes';
import { SOURCE_TAG } from '../../lib/site';
---

<section class="notes" aria-labelledby="notes-title">
  <div class="wrap">
    <!-- The small print stays out of the story until someone asks for it: a
         footnote marker opens the list and goes to its note (motion/core.ts). -->
    <details data-notes>
      <summary>
        <h2 id="notes-title" class="caption">Footnotes · measured on Nova {SOURCE_TAG}</h2>
        <span class="caption notes__count">{homeNotes.length} notes</span>
        <svg viewBox="0 0 12 12" aria-hidden="true" class="notes__chevron"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      </summary>
      <ol>
      {
        homeNotes.map((id, i) => (
          <li id={`fn-${i + 1}`}>
            <span class="notes__n mono">{i + 1}</span>
            <p>
              {claims[id].note}{' '}
              <a href={claims[id].src.url} rel="noopener" class="notes__src mono">
                {claims[id].src.label} ↗
              </a>
            </p>
          </li>
        ))
      }
      </ol>
    </details>
  </div>
</section>

<style>
  .notes {
    padding-block: 0.75rem;
    border-top: 1px solid var(--line);
    background: var(--ink);
    position: relative;
    z-index: 2;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    color: var(--faint);
    transition: color 0.2s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  details[open] summary {
    color: var(--paper);
  }
  h2 {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: inherit;
  }
  .notes__count {
    margin-right: auto;
    color: var(--faint);
  }
  .notes__chevron {
    width: 0.75rem;
    height: 0.75rem;
    transition: rotate 0.4s var(--ease-out);
  }
  details[open] .notes__chevron {
    rotate: 180deg;
  }
  ol {
    padding-block: 1rem clamp(2rem, 5vw, 4rem);
    columns: 2;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--muted);
  }
  li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    break-inside: avoid;
    padding-bottom: 0.9rem;
    scroll-margin-top: 6rem;
  }
  li:target p,
  li[data-current] p {
    color: var(--paper);
  }
  .notes__n {
    color: var(--faint);
  }
  .notes__src {
    color: var(--paper-dim);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .notes__src:hover {
    color: var(--nova);
  }
  @media (max-width: 760px) {
    ol {
      columns: 1;
    }
  }
</style>
