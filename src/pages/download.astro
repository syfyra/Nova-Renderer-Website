---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/primitives/CodeBlock.astro';
import Requirements from '../components/data/Requirements.astro';
import Icon from '../components/primitives/Icon.astro';
import { getGitHub } from '../lib/github';
import { REPO_URL, RELEASES_URL, href, source } from '../lib/site';

const gh = await getGitHub();
const does = [
  'Installs for the current user, without administrator rights, to %LOCALAPPDATA%\\Programs\\Nova by default. Any folder can be chosen.',
  'Registers Nova with Houdini 22.0 through a package file in Documents\\houdini22.0\\packages',
  'Adds “Nova for Houdini” to Apps & features, with an uninstaller that removes only what Nova put there',
  'Refuses to replace Nova’s files while Houdini, hython, husk or hbatch is running',
  'Shows the Houdini installations and the graphics card it finds',
  'Keeps a nova.json that was already there and points elsewhere as nova.json.bak, and restores it when Nova is uninstalled',
];
---

<Base title="Download" description="Download Nova for Houdini 22.0 on Windows x64. One installer, per user, without administrator rights. Or build Nova from source.">
  <div class="wrap dl">
    <header class="page-head" data-stagger>
      <p class="eyebrow">Download</p>
      <h1 class="display-1">Download Nova for Houdini 22.0</h1>
      <p class="lede">One installer for Windows. Free, open source, MIT licensed.</p>
    </header>

    <section class="dl__main" aria-label="Installer">
      <div class="dl__card card">
        <p class="caption dl__file">{gh.installerName}</p>
        <p class="dl__version">Nova {gh.version}</p>
        <p class="caption dl__meta">
          Windows x64 · Houdini 22.0{gh.installerSize && ` · ${gh.installerSize}`}
        </p>
        <a class="btn btn--primary dl__btn" href={gh.installerUrl ?? gh.releaseUrl} rel="noopener">
          <span class="btn__dot" aria-hidden="true"></span>
          {gh.installerUrl ? 'Download the installer' : 'Download from GitHub Releases'}
        </a>
        <p class="caption dl__alt">
          <a class="link" href={RELEASES_URL} rel="noopener">All releases</a>
          <span aria-hidden="true"> · </span>
          <a class="link" href={REPO_URL} rel="noopener">Source code</a>
        </p>
      </div>

      <div class="dl__req">
        <h2 class="eyebrow">Before you download</h2>
        <Requirements />
        <p class="body dl__note">
          The installer is not code-signed, so Windows SmartScreen may show a warning before it runs. Close Houdini
          first: a loaded <span class="mono">hdNova.dll</span> cannot be replaced.
        </p>
      </div>
    </section>

    <section class="dl__section">
      <h2 class="display-3">What the installer does</h2>
      <ul class="dl__list">
        {does.map((d) => <li>{d}</li>)}
      </ul>
    </section>

    <section class="dl__section dl__two">
      <div>
        <h2 class="display-3">After installing</h2>
        <ol class="dl__steps">
          <li><span class="caption num">1</span><p>Start Houdini 22.0 and open Solaris</p></li>
          <li><span class="caption num">2</span><p>Choose <strong>Nova CPU</strong> or <strong>Nova XPU</strong> in the viewport’s renderer menu</p></li>
          <li><span class="caption num">3</span><p>Press <kbd>Tab</kbd> and choose Rendering, then <strong>Nova (Setup)</strong>, which builds the render settings, a render pass and a USD Render ROP</p></li>
        </ol>
        <p class="dl__more">
          <a class="arrow" href={href('/docs')}>
            Get started <Icon name="arrow-right" />
          </a>
        </p>
      </div>
      <div class="dl__codes">
        <CodeBlock label="husk" lines={['husk --renderer Nova scene.usda -o out.exr', 'husk --renderer "Nova XPU" scene.usda -o out.exr']} />
        <CodeBlock label="Silent install" lines={[`${gh.installerName} --silent [--dir <folder>]`, '"Uninstall Nova.exe" --uninstall [--silent]']} />
      </div>
    </section>

    <section class="dl__section dl__two">
      <div>
        <h2 class="display-3">Build from source</h2>
        <p class="body">
          Nova builds with Visual Studio 2022 Build Tools, CMake and vcpkg against a Houdini 22.0 installation. CUDA 12.8
          or later is optional and enables Nova XPU and the OptiX denoiser. The first configure builds Embree and takes
          about 20 minutes.
        </p>
        <p class="dl__more">
          <a class="arrow" href={href('/docs/build')}>
            Build instructions <Icon name="arrow-right" />
          </a>
        </p>
      </div>
      <div>
        <CodeBlock
          label="Build"
          lines={['cmake --preset vs2022', 'cmake --build --preset release', 'ctest --preset release', 'cmake --install build/vs2022 --config Release']}
        />
        <p class="caption dl__cap">
          Details in the <a class="link" href={source('README.md', 'build-from-source')} rel="noopener">README</a> and the
          <a class="link" href={source('tools/installer/README.md')} rel="noopener">installer notes</a>.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .dl {
    padding-bottom: var(--section);
  }
  .dl__main {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 40px var(--gap-xl);
    align-items: start;
  }
  .dl__card {
    border-radius: var(--r-xl);
    padding: var(--gap-l);
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .dl__version {
    font-size: var(--h1);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .dl__btn {
    margin-top: 24px;
  }
  .dl__alt {
    margin-top: 8px;
  }
  .dl__req .eyebrow {
    margin-bottom: 12px;
  }
  .dl__note {
    margin-top: 16px;
    font-size: var(--t-14);
    line-height: 20px;
  }
  .dl__note .mono {
    color: var(--text);
  }
  .dl__section {
    margin-top: var(--section);
    padding-top: 32px;
    border-top: 1px solid var(--line-2);
  }
  .dl__two {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px var(--gap-xl);
    align-items: start;
  }
  .dl__two .body {
    margin-top: 16px;
  }
  .dl__list {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(288px, 1fr));
    gap: 0 var(--gap-m);
  }
  .dl__list li {
    padding-block: 16px;
    border-top: 1px solid var(--line);
    font-size: var(--t-14);
    line-height: 20px;
    color: var(--text-2);
  }
  .dl__steps {
    margin-top: 24px;
  }
  .dl__steps li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
    color: var(--text-2);
  }
  .dl__steps .caption {
    line-height: 24px;
  }
  .dl__steps strong {
    color: var(--text);
    font-weight: 500;
  }
  .dl__more {
    margin-top: 24px;
  }
  .dl__codes {
    display: grid;
    gap: 16px;
  }
  .dl__cap {
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .dl__main,
    .dl__two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
